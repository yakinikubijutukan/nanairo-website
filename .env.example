# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real keys.

# Required. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact form submissions are delivered.
# Defaults to info@nanairo-llc.com (see components/Footer.tsx) if not set.
CONTACT_RECIPIENT_EMAIL=info@nanairo-llc.com

# Optional. The "from" address Resend sends as. Must be on a domain you've
# verified in the Resend dashboard (Settings -> Domains). Until nanairo.jp
# is verified there, leave this as the sandbox sender below — it works
# immediately with no DNS setup, but Resend limits what it can be used for
# (e.g. delivery may be restricted to your own account's email while
# testing). Swap it for something like "Nanairo <no-reply@nanairo.jp>"
# once the domain is verified.
CONTACT_FROM_EMAIL="Nanairo Website <onboarding@resend.dev>"
